# Copy to .env.local. Fill values locally; never commit .env.local.
# CoinMarketCap Developer API: https://pro.coinmarketcap.com/account
CMC_PRO_API_KEY=

# Zoho EU Self Client: https://api-console.zoho.eu/
# For the fictional course CRM exercises, authorize ZohoCRM.modules.ALL.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Fresh, single-use grant code. Auto exchange clears this after success.
ZOHO_GRANT_CODE=
# The helper writes these after exchange/refresh; leave blank initially.
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN_EXPIRES_AT=

# Do not add website passwords, OTPs or cookies here.
# Google Apps Script uses its own private Script Property CMC_PRO_API_KEY.
# Colab credentials are entered privately in its runtime, never saved outputs.
