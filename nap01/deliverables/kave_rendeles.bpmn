<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Cafe" targetNamespace="http://fsega.ubbcluj.ro/bpa">
  <bpmn:process id="Process_Cafe" isExecutable="false">
    <bpmn:startEvent id="start" name="Vendég rendel" />
    <bpmn:task id="order" name="Rendelés felvétele" />
    <bpmn:task id="coffee" name="Kávé elkészítése" />
    <bpmn:task id="payment" name="Fizetés" />
    <bpmn:endEvent id="end" name="Vendég kiszolgálva" />
    <bpmn:sequenceFlow id="flow_start_order" sourceRef="start" targetRef="order" />
    <bpmn:sequenceFlow id="flow_order_coffee" sourceRef="order" targetRef="coffee" />
    <bpmn:sequenceFlow id="flow_coffee_payment" sourceRef="coffee" targetRef="payment" />
    <bpmn:sequenceFlow id="flow_payment_end" sourceRef="payment" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Cafe">
    <bpmndi:BPMNPlane id="Plane_Cafe" bpmnElement="Process_Cafe">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start"><dc:Bounds x="170" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="142" y="226" width="92" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_order" bpmnElement="order"><dc:Bounds x="300" y="167" width="110" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_coffee" bpmnElement="coffee"><dc:Bounds x="480" y="167" width="110" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_payment" bpmnElement="payment"><dc:Bounds x="660" y="167" width="110" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end"><dc:Bounds x="900" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="862" y="226" width="112" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_start_order" bpmnElement="flow_start_order"><di:waypoint x="206" y="200" /><di:waypoint x="300" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_order_coffee" bpmnElement="flow_order_coffee"><di:waypoint x="410" y="200" /><di:waypoint x="480" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_coffee_payment" bpmnElement="flow_coffee_payment"><di:waypoint x="590" y="200" /><di:waypoint x="660" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_payment_end" bpmnElement="flow_payment_end"><di:waypoint x="770" y="200" /><di:waypoint x="900" y="200" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>