<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Routine" targetNamespace="http://fsega.ubbcluj.ro/bpa">
  <bpmn:process id="Process_Routine" isExecutable="false">
    <bpmn:startEvent id="start" name="Ébresztő megszólal" />
    <bpmn:task id="get_up" name="Felkelek" />
    <bpmn:task id="wash_dress" name="Tisztálkodom és felöltözöm" />
    <bpmn:task id="breakfast" name="Megreggelizem" />
    <bpmn:task id="pack_bag" name="Összekészítem a táskám" />
    <bpmn:task id="leave_home" name="Elindulok otthonról" />
    <bpmn:endEvent id="end" name="A reggeli rutin véget ér" />
    <bpmn:sequenceFlow id="flow_0" sourceRef="start" targetRef="get_up" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="get_up" targetRef="wash_dress" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="wash_dress" targetRef="breakfast" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="breakfast" targetRef="pack_bag" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="pack_bag" targetRef="leave_home" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="leave_home" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Routine">
    <bpmndi:BPMNPlane id="Plane_Routine" bpmnElement="Process_Routine">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start"><dc:Bounds x="150" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="112" y="226" width="112" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_get_up" bpmnElement="get_up"><dc:Bounds x="250" y="167" width="110" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_wash_dress" bpmnElement="wash_dress"><dc:Bounds x="420" y="167" width="145" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_breakfast" bpmnElement="breakfast"><dc:Bounds x="625" y="167" width="110" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_pack_bag" bpmnElement="pack_bag"><dc:Bounds x="795" y="167" width="145" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_leave_home" bpmnElement="leave_home"><dc:Bounds x="1000" y="167" width="145" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end"><dc:Bounds x="1205" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1161" y="226" width="124" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_0" bpmnElement="flow_0"><di:waypoint x="186" y="200" /><di:waypoint x="250" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_1" bpmnElement="flow_1"><di:waypoint x="360" y="200" /><di:waypoint x="420" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_2" bpmnElement="flow_2"><di:waypoint x="565" y="200" /><di:waypoint x="625" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_3" bpmnElement="flow_3"><di:waypoint x="735" y="200" /><di:waypoint x="795" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_4" bpmnElement="flow_4"><di:waypoint x="940" y="200" /><di:waypoint x="1000" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_5" bpmnElement="flow_5"><di:waypoint x="1145" y="200" /><di:waypoint x="1205" y="200" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>