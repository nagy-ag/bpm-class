    <bpmn:sequenceFlow id="f8" sourceRef="ev2" targetRef="t5" />
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="e2" />
    <bpmn:sequenceFlow id="f10" sourceRef="receipt" targetRef="returns" />
    <bpmn:sequenceFlow id="f11" sourceRef="returns" targetRef="days14" />
    <bpmn:sequenceFlow id="f12" sourceRef="returns" targetRef="request" />
    <bpmn:sequenceFlow id="f13" sourceRef="days14" targetRef="e1" />
    <bpmn:sequenceFlow id="f14" sourceRef="request" targetRef="handle" />
    <bpmn:sequenceFlow id="f15" sourceRef="handle" targetRef="er" />
  </bpmn:process>
