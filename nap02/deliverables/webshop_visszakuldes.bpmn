<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_WebshopReturns" targetNamespace="http://fsega.ubbcluj.ro/bpa">
  <bpmn:process id="Process_WebshopReturns" isExecutable="false">
    <bpmn:startEvent id="s" name="Rendelés beérkezik">
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Rendelés rögzítése">
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="t2" name="Fizetési link küldése">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="g0">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ev1" name="Fizetés megérkezik">
      <bpmn:messageEventDefinition id="ev1_message" />
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ev2" name="48 óra letelt">
      <bpmn:timerEventDefinition id="ev2_timer">
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Csomag összekészítése">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Futárnak átadás">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="receipt" name="Átvétel visszaigazolása">
      <bpmn:messageEventDefinition id="receipt_message" />
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="returns">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="days14" name="14 nap letelt">
      <bpmn:timerEventDefinition id="days14_timer">
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="request" name="Visszaküldési igény érkezik">
      <bpmn:messageEventDefinition id="request_message" />
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="handle" name="Visszáru kezelése">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Rendelés teljesítve">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="er" name="Rendelés lezárva visszaküldéssel">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t5" name="Rendelés törlése">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e2" name="Rendelés lezárva fizetés nélkül">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f2" sourceRef="t2" targetRef="g0" />
    <bpmn:sequenceFlow id="f3" sourceRef="g0" targetRef="ev1" />
    <bpmn:sequenceFlow id="f4" sourceRef="g0" targetRef="ev2" />
    <bpmn:sequenceFlow id="f5" sourceRef="ev1" targetRef="t3" />
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4" />
