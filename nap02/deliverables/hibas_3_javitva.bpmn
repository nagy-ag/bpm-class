<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ComplaintFixed" targetNamespace="http://fsega.ubbcluj.ro/bpa">
  <bpmn:process id="Process_ComplaintFixed" isExecutable="false">
    <bpmn:startEvent id="s" name="Panasz beérkezik">
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Panasz kivizsgálása">
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Válaszlevél írása és javítása">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:task>
    <bpmn:userTask id="t3" name="Válaszlevél jóváhagyása">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Jóváhagyta a vezető?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="send" name="Jóváhagyott válasz elküldése">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e" name="Panasz lezárva">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f3" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="send" name="igen" />
    <bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t2" name="nem" />
    <bpmn:sequenceFlow id="f6" sourceRef="send" targetRef="e" />
  </bpmn:process>
