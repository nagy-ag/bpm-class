<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://fsega.ubbcluj.ro/bpa">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="PoolM" name="Meridian Biztosító" processRef="Process_1"/>
    <bpmn:participant id="PoolC" name="Ügyfél (webes kárbejelentő űrlap)"/>
    <bpmn:messageFlow id="m0" name="kitöltött űrlap" sourceRef="PoolC" targetRef="s"/>
    <bpmn:messageFlow id="m1" name="hiánypótló levél" sourceRef="t2" targetRef="PoolC"/>
    <bpmn:messageFlow id="m2" name="pótolt adat" sourceRef="PoolC" targetRef="ev1"/>
    <bpmn:messageFlow id="m3" name="visszaigazoló e-mail" sourceRef="t4" targetRef="PoolC"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="laneA" name="Automata feldolgozás">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="laneU" name="Kárügyintéző">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Űrlap beérkezik"><bpmn:messageEventDefinition id="s_def"/></bpmn:startEvent>
    <bpmn:task id="t1" name="Automatikus ellenőrzés"/>
    <bpmn:exclusiveGateway id="g1" name="Hiánytalan a bejelentés?"/>
    <bpmn:sendTask id="t2" name="Hiánypótlás kérése"/>
    <bpmn:intermediateCatchEvent id="ev1" name="Pótlás megérkezik"><bpmn:messageEventDefinition id="ev1_def"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Kárakta létrehozása"/>
    <bpmn:sendTask id="t4" name="Visszaigazolás küldése"/>
    <bpmn:task id="t5" name="Ügyintéző kijelölése"/>
    <bpmn:endEvent id="e" name="Kárügy megnyitva"/>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="t1"/>
    <bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f2" name="igen" sourceRef="g1" targetRef="t3"/>
    <bpmn:sequenceFlow id="f3" name="nem" sourceRef="g1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t2" targetRef="ev1"/>
    <bpmn:sequenceFlow id="f5" sourceRef="ev1" targetRef="t1"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="e"/>
  </bpmn:process>
